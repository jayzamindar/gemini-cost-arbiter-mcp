# Gemini Cost Arbiter MCP - Environment Configuration Template
# Copy this file to .env and populate your active credentials.

# Operational Environment & Security
ENVIRONMENT=development
REQUIRE_AUTH=false
MCP_API_KEY=your_secure_mcp_api_key_here
PLAN_SIGNING_SECRET=your_32_byte_hmac_signing_secret_here
DB_PATH=/app/data/finops.db

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DEFAULT_MODEL=gemini-3.8-flash-high
THINKING_BUDGET=2048
MAX_OUTPUT_TOKENS=8192
MAX_SESSION_TOKEN_BUDGET=500000
DAILY_API_COST_LIMIT_USD=10.00
MAX_PAYLOAD_BYTES=10485760
CATALOG_PATH=config/instance_mappings.json
PROMPTS_DIR=prompts

# Multi-Model Secondary Fallback Configuration (Optional)
OPENROUTER_API_KEY=your_optional_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SECONDARY_MODEL=qwen/qwen-2.5-coder-32b-instruct

# FinOps Guardrail & Policy Thresholds
MAX_ACCEPTABLE_RISK=5
LOW_UTILIZATION_THRESHOLD_PCT=10.0
MODERATE_UTILIZATION_THRESHOLD_PCT=40.0
SAFETY_AUTO_REMEDIATE_MAX_RISK=3

# Model Context Protocol (MCP) Server Configuration
MCP_SERVER_NAME=gemini-cost-arbiter-mcp
MCP_SERVER_VERSION=1.0.0
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Logging & Observability
LOG_LEVEL=INFO
